
from abc import ABC, abstractmethod

class Notificacion(ABC):
    def __init__(self, destino: str, costo_base: float = 0.0):
        self._destino = destino.strip()
        self._costo_base = costo_base

    @property
    def destino(self) -> str:
        return self._destino

    @abstractmethod
    def validar_destino(self) -> bool:
        """Reglas mínimas del canal: formato/longitud/vacío."""
        pass

    @abstractmethod
    def validar_mensaje(self, mensaje: str) -> bool:
        """Reglas del mensaje (ej. longitud máxima, no vacío)."""
        pass

    @abstractmethod
    def enviar(self, mensaje: str) -> bool:
        """Simula el envío; retorna True si exitoso, False si falla."""
        pass

    @abstractmethod
    def costo(self, mensaje: str) -> float:
        """Costo del envío considerando reglas del canal."""
        pass

    def __eq__(self, other) -> bool:
        return isinstance(other, Notificacion) and self.destino.lower() == other.destino.lower()

    def __hash__(self):
        return hash(self.destino.lower())



class CanalCorreo(Notificacion):
    def __init__(self, email: str):
        super().__init__(email, costo_base=1.0)
        
    def validar_destino(self) -> bool:
        if not isinstance(self.destino, str):
            return False

        if self.destino.count("@") != 1:
            return False

        usuario, dominio = self.destino.split("@")

        if not usuario or not dominio:
            return False

        if "." not in dominio:
            return False

        if dominio.startswith(".") or dominio.endswith("."):
            return False

        return True

    def validar_mensaje(self, mensaje: str) -> bool:
        return isinstance(mensaje, str) and mensaje.strip() != ""

    def enviar(self, mensaje: str) -> bool:
        # Simulación: el correo rara vez falla
        return self.validar_destino() and self.validar_mensaje(mensaje)

    def costo(self, mensaje: str) -> float:
        # Costo fijo por correo
        return self._costo_base


class CanalSMS(Notificacion):
    MAX_LEN = 160

    def __init__(self, telefono: str):
        super().__init__(telefono, costo_base=0.5)

    def validar_destino(self) -> bool:
        return self.destino.isdigit() and 9 <= len(self.destino) <= 15

    def validar_mensaje(self, mensaje: str) -> bool:
        return isinstance(mensaje, str) and mensaje.strip() != "" and len(mensaje) <= self.MAX_LEN

    def enviar(self, mensaje: str) -> bool:
        # Simulación simple: si se pasa de 160, no envía
        return self.validar_destino() and self.validar_mensaje(mensaje)

    def costo(self, mensaje: str) -> float:
        # Costo por segmento de 160 caracteres (redondeo hacia arriba)
        segmentos = (len(mensaje) // self.MAX_LEN) + (1 if len(mensaje) % self.MAX_LEN else 0)
        return self._costo_base * segmentos


class CanalWebhook(Notificacion):
    def __init__(self, url_o_token: str):
        super().__init__(url_o_token, costo_base=0.2)

    def validar_destino(self) -> bool:
        return self.destino.startswith(("http://", "https://")) or len(self.destino) >= 20

    def validar_mensaje(self, mensaje: str) -> bool:
        return isinstance(mensaje, str) and mensaje.strip() != ""

    def enviar(self, mensaje: str) -> bool:
        # Simula posible fallo si token/url es muy corto
        return self.validar_destino() and self.validar_mensaje(mensaje)

    def costo(self, mensaje: str) -> float:
        # Costo variable por longitud (simulada)
        return self._costo_base + (len(mensaje) * 0.001)

